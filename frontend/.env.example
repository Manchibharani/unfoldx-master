# Copy to .env.local

# WebSocket base URL the backend exposes. The frontend appends /{workspace_id}.
# e.g. ws://localhost:8000/ws/workspace
NEXT_PUBLIC_WORKSPACE_WS_URL=ws://localhost:8000/ws/workspace

# REST base URL for the same backend. Control actions (submit task, stop,
# redirect, budget override, add agent, attach files) are sent here. Leave
# unset to keep those actions local-only with a "not yet connected to backend"
# note in the Recent controls list.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Which workspace to open on load.
NEXT_PUBLIC_WORKSPACE_ID=demo-workspace

# Set to 1 to run against the built-in mock event generator instead of a
# real backend — useful for building/demoing the UI independently while
# the backend is still in progress. Leave unset (or 0) once the backend
# WebSocket endpoint above is live.
NEXT_PUBLIC_MOCK=0

# Default URL shown in the "Live preview" window on the canvas — the site/app
# the agents are producing (usually a localhost dev server).
NEXT_PUBLIC_PREVIEW_URL=
