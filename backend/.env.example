# Universal AI Workspace — Backend env template
# Copy to `.env` and adjust. Every provider CLI command below is a template
# that can be edited to match the actually-installed CLI flags without touching code.
#   cp .env.example .env

# --- runtime dirs -----------------------------------------------------------
# DATA_DIR defaults to ./data (SQLite db + per-workspace sandboxes + generated secret key).
# DATABASE_URL overrides it with Postgres, e.g. postgresql+asyncpg://uaw:uaw@localhost:5432/uaw
DATA_DIR=./data
DATABASE_URL=
REDIS_URL=

# --- secrets -----------------------------------------------------------------
# Left blank in dev: the app generates one, persists it to DATA_DIR/.secret_key, and
# keeps it stable across restarts (JWT signing + provenance HMAC). Set explicitly
# in production and back it up, or every signature becomes invalid.
SECRET_KEY=
FERNET_KEY=

# --- people auth --------------------------------------------------------------
# open: no token needed; callers act as a guest with OPEN_MODE_ROLE (dev/demo).
# jwt : every HTTP/WS call needs a valid token (built-in login or external HS256 JWT).
AUTH_MODE=open
OPEN_MODE_ROLE=approve
# External JWT (Supabase/Auth0): the HS256 secret they sign with.
EXTERNAL_JWT_SECRET=
TOKEN_TTL_MINUTES=1440

# --- workspace / CORS ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://aashvarsha26.github.io
SEED_DEMO_WORKSPACE=true
DEMO_WORKSPACE_ID=demo-workspace

# --- orchestration -------------------------------------------------------------
MAX_CONCURRENT_SUBTASKS=3
SUBTASK_TIMEOUT_SECONDS=900
PLAN_TIMEOUT_SECONDS=180
DEFAULT_BUDGET_CAP_USD=5.0
WS_REPLAY_DEFAULT=200
ENTITLEMENT_POLL_SECONDS=60
MAX_UPLOAD_BYTES=10485760

# --- simulation -----------------------------------------------------------------
# When a provider CLI is missing this runs a clearly-labelled simulated agent so the
# whole pipeline stays demoable. Set ALLOW_SIMULATION=0 in production.
ALLOW_SIMULATION=true
SIM_DELAY_SECONDS=0.35

# Failover: when a real CLI executor fails hard (bad login, crash), the subtask is re-routed
# to the next-best agent and the failing provider is benched for this many seconds.
# NOTE: an AUTH failure ("not signed in") is always benched for the in-code AUTH_BENCH_SECONDS
# (600s) regardless of this setting, because a login cannot come back mid-task.
FAILOVER_COOLDOWN_SECONDS=600

# --- provider CLI command templates ({prompt} becomes ONE argv token; no shell) ---
BOB_CMD=bob run --output-format stream-json {prompt}
BOB_PLAN_CMD=bob run --mode plan --output-format stream-json {prompt}
CLAUDE_CMD=claude -p {prompt} --output-format stream-json --verbose --permission-mode acceptEdits
CLAUDE_PLAN_CMD=claude -p {prompt} --output-format stream-json --verbose --permission-mode plan
CODEX_CMD=codex exec --json {prompt}
CODEX_PLAN_CMD=codex exec --json {prompt}
GEMINI_CMD=agy -p {prompt} --output-format stream-json --mode accept-edits
GEMINI_PLAN_CMD=agy -p {prompt} --output-format stream-json --mode plan

# --- provider API keys (the var each CLI reads) ---------------------------------
# These VALUES are live configuration, not documentation: on startup the backend imports
# every KEY=VALUE here into its process environment (without overriding real env vars), and
# entitlement.credential_env() injects the matching one into each provider's subprocess.
# Leaving one empty (or commented) means that provider has no API-key credential: it either
# uses a host CLI login (claude/codex/agy/copilot sign-in on this machine) or routing treats
# it as unauthenticated and skips it for real runs. Keys entered through the UI
# (POST /providers {api_key}) are stored encrypted in the workspace DB and win over these.
BOBSHELL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=
GITHUB_TOKEN=